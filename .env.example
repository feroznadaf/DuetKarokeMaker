# ========================================================
# Duet Karaoke Maker - Environment Configuration Template
# Copy this file to .env and configure your secret credentials.
# NEVER commit the real .env file to version control.
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=production
DEBUG=false

# Admin Authentication Credentials (Server-Side Only)
ADMIN_EMAIL=admin@example.com

# PBKDF2 Salted Hash (Generate with: node hash_password.js "YourStrongPassword")
ADMIN_PASSWORD_HASH=your_salt_hex:your_hash_hex

# Cryptographic random secret for signing admin session tokens (32-byte hex)
ADMIN_SESSION_SECRET=change_me_to_a_random_64_character_hex_string

# CORS Whitelist (comma-separated origins allowed to make API requests)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cashfree Payment Gateway Configuration
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# Supabase Server-Side Connectivity & Webhook Token Credit Secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
PAYMENT_SECRET_TOKEN=change_me_to_a_random_64_character_hex_string
SUPABASE_SERVICE_ROLE_KEY=

# Optional Server-Side Google Gemini API Key for Auto-Duet
GEMINI_API_KEY=

# Supabase High-Concurrency PostgreSQL Connection String
# Use Port 6543 (Supavisor Transaction Pooler) to support thousands of concurrent users:
# DATABASE_URL=postgresql://postgres.odvgmniswfpahwkqwtcw:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
